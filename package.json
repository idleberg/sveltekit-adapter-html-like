		"test": "pnpm -r --workspace-concurrency 1 --filter=\"./test/**\" test"
	},
	"dependencies": {
		"html-minifier-terser": "^7.2.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.9.6"
	},
	"devDependencies": {
