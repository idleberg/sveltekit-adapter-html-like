{
	"name": "sveltekit-adapter-html-like",
	"description": "SvelteKit adapter for HTML-like template engines such as PHP, Blade, Handlebars, etc.",
	"version": "0.3.2",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/sveltekit-adapter-html-like.git"
	},
	"license": "MIT",
	"keywords": [
		"sveltekit-adapter",
		"svelte",
		"sveltekit",
		"php",
		"blade",
		"embedded ruby",
		"erb",
		"moustache",
		"handlebars",
		"ejs"
	],
	"type": "module",
	"files": [
		"adapter.js",
		"index.js",
		"index.d.ts",
		"internal.d.ts",
		"platforms.js",
		"LICENSE",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "index.d.ts",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24.0.0"
