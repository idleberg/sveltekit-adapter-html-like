		"@sveltejs/kit": "^2.70.3",
		"@types/html-minifier-terser": "^7.0.2",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^24.13.3",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"typescript": "^5.9.3",
		"vite": "^8.2.2"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0"
	},
