{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"target": "es2022",
		"module": "node16",
		"moduleResolution": "node16",
		"allowSyntheticDefaultImports": true
	},
	"include": [
		"adapter.js",
		"index.js",
		"index.d.ts",
		"internal.d.ts",
		"platforms.js",
		"test/utils.js"
	]
}
